+    @classmethod
+    def convert_m4a_to_flac(cls, input_path: str, output_path: str):
+        # 解码 AAC 后编码成 FLAC（内置 FFmpeg 的 flac 编码器是原生实现，
+        # 没有 libFLAC 也照样可用）。源本来就是有损 AAC，转 FLAC 只是换了个
+        # 无损容器/编码，不会提升音质，但兼容性与后续编辑更省事
+        #
+        # 显式 -f flac：与 remux_audio 同样的原因，不依赖扩展名推断容器
+        # -compression_level 8 是 0~12 档里性价比最高的一档（再往上编码时间
+        # 明显变长、体积收益很小），单曲转换仍在秒级
+        return (
+            cls()
+            .add_input(input_path)
+            .add_param("-c:a", "flac")
+            .add_param("-compression_level", "8")
+            .add_param("-f", "flac")
+            .add_output(output_path)
+        )
     
