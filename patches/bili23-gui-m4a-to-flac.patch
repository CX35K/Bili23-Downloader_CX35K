 # alias
 translate = QCoreApplication.translate
+
+def localize(simplified: str, traditional: str, english: str) -> str:
+    """
+    按当前界面语言直接取一段文案
+
+    UI 文案平时走 Qt 的 .qm 翻译（编译进 res/resources_rc.py），改不了资源就没法
+    给新字符串补翻译，因此新加的界面文字用这里按语言现取：AUTO 时跟随系统
+    locale，其余情况跟 main.py 加载翻译时用的是同一份 config.language。
+    """
+    from .config import config
+
+    try:
+        name = config.get(config.language).value.name()
+
+    except Exception:    # noqa: BLE001  配置尚未初始化时退回英文，不能因为一句文案崩界面
+        return english
+
+    if name.startswith("zh_TW") or "Hant" in name:
+        return traditional
+
+    if name.startswith("zh"):
+        return simplified
+
+    return english
 
